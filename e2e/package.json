{
  "name": "secretlink-e2e",
  "version": "0.19.7",
  "private": true,
  "description": "Tests end-to-end Playwright contre la stack Docker complète",
  "author": "Nicolas BARRAT",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=10"
  },
  "scripts": {
    "test": "playwright test",
    "typecheck": "tsc --noEmit",
    "test:ci": "playwright test --reporter=list,junit,html",
    "report": "playwright show-report",
    "install:browsers": "playwright install --with-deps chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/node": "^26.4.1",
    "otplib": "^13.4.1",
    "typescript": "^6.0.3"
  }
}
