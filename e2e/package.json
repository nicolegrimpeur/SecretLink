{
  "name": "secretlink-e2e",
  "version": "0.21.1",
  "private": true,
  "description": "Tests end-to-end Playwright contre la stack Docker complète",
  "author": "Nicolas BARRAT",
  "type": "module",
  "engines": {
    "node": ">=26 <27",
    "npm": ">=10"
  },
  "scripts": {
    "test": "playwright test",
    "typecheck": "tsc --noEmit",
    "test:ci": "playwright test --reporter=list,junit,html",
    "report": "playwright show-report",
    "install:browsers": "playwright install --with-deps chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "otplib": "^13.6.0",
    "typescript": "^7.0.2"
  }
}
