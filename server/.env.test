# ─────────────────────────────────────────────────────────────────────────────
#  Environnement des tests d'intégration.  COMMITTÉ VOLONTAIREMENT.
#
#  Toutes les valeurs ci-dessous sont JETABLES : elles ne protègent rien, ne
#  correspondent à aucun déploiement, et n'ont de sens que face à la base
#  éphémère de deploy/docker-compose.test.yml.
#
#  ⚠️ Ne JAMAIS recopier ici une valeur de deploy/.env. La suite de tests
#  TRUNCATE les tables à chaque test : pointée sur une configuration réelle,
#  elle détruirait les données. Et MASTER_KEY_V1 est la clé AES qui protège
#  tous les secrets stockés - son rayon d'action est total.
#
#  Ces valeurs gagnent sur le .env local : config/env.ts appelle dotenv.config()
#  sur server/.env, et dotenv n'écrase jamais une variable déjà présente dans
#  process.env - or vitest.config.ts les y injecte avant tout import.
# ─────────────────────────────────────────────────────────────────────────────

# 'test' fait trois choses d'un coup : cookies non-secure (supertest parle en
# HTTP), pas de worker pino-pretty (qui ferait pendre le runner), et messages
# d'erreur 500 génériques donc indépendants de l'environnement, donc figeables.
NODE_ENV=test

FRONT_BASE_URL=http://127.0.0.1:8100

# Port 3307 : évite de heurter un MySQL déjà présent sur 3306.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=link
MYSQL_PASSWORD=cipass
MYSQL_DB=secretLink

# Exactement 64 caractères hex, exigé par la regex du schéma zod.
MASTER_KEY_V1=00000000000000000000000000000000000000000000000000000000deadbeef
KEY_VERSION=1

# 32 caractères minimum chacun.
SESSION_SECRET=test-session-secret-strictly-throwaway-0000
IP_HMAC_SECRET=test-ip-hmac-secret-strictly-throwaway-0000

# 'fatal' est le niveau le plus silencieux que l'enum accepte ('silent' n'existe pas).
LOG_LEVEL=fatal

MAINTENANCE_MODE=0

# 1 proxy de confiance : req.ip vaut la dernière entrée de X-Forwarded-For, ce
# dont les tests se servent pour donner à chacun son propre bucket de rate limit.
TRUST_PROXY=1
