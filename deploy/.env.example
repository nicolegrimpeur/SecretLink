# ==========================================
# Database Configuration
# ==========================================
MYSQL_USER=root
MYSQL_PASSWORD=root

# ==========================================
# Server Configuration
# ==========================================
NODE_ENV=production
PORT=3000
API_BASE_URL=http://localhost:3000
FRONT_BASE_URL=http://localhost:8100

# Database connection (from container to container)
MYSQL_HOST=secretlink-db
MYSQL_PORT=3306

# ==========================================
# Security Keys
# ==========================================
# Master encryption key for secrets
MASTER_KEY_V1=your-secret-key-here

# Key version for managing key rotations
KEY_VERSION=1

# Session secret for session management
SESSION_SECRET=your-session-secret-here

# HMAC secret for pseudonymizing IPs / emails in logs (min 32 chars)
IP_HMAC_SECRET=your-ip-hmac-secret-here

# ==========================================
# Reverse proxy / réseau
# ==========================================
# Nombre de proxys de confiance devant l'application, pour la résolution de l'IP
# client (rate limiting et pseudonymisation des logs).
#   0 = application exposée directement, sans proxy. X-Forwarded-For est ignoré.
#   1 = un reverse proxy devant (cas le plus courant : Traefik, nginx, Caddy...).
#   2+ = chaîne de plusieurs proxys de confiance.
# Mettre 0 en exposition directe est important : sinon un client peut forger
# X-Forwarded-For, contourner les quotas et fausser les hash d'IP des logs.
TRUST_PROXY=1

# Origines CORS autorisées, séparées par des virgules. Vide = valeurs par défaut
# intégrées. FRONT_BASE_URL est toujours autorisée, quelle que soit la valeur.
ALLOWED_ORIGINS=

# Plages Cloudflare (CIDR séparés par des virgules) autorisées à définir
# CF-Connecting-IP. Vide = plages intégrées à l'application. À renseigner
# uniquement si Cloudflare publie de nouvelles plages avant une mise à jour.
# Un CIDR invalide empêche le démarrage, volontairement.
CLOUDFLARE_IPS=

# ==========================================
# Logging
# ==========================================
LOG_LEVEL=info
