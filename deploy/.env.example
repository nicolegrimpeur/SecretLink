# ==========================================
# Version déployée
# ==========================================
# Tag des images tirées depuis GHCR, sans le préfixe « v » : c'est la version du
# package.json racine, celle que publie la release. Épingler la version exacte,
# JAMAIS `latest` - sinon « qu'est-ce qui tourne ? » devient insoluble et un
# rollback relève de la devinette. Rollback = remettre la valeur précédente ici,
# puis `docker compose up -d`.
#
# Versions disponibles : https://github.com/nicolegrimpeur/SecretLink/releases
# Vide, Compose refuse de démarrer : choisir explicitement une version (ex. 1.2.3).
# Inutile pour docker-compose-dev.yml, qui construit depuis les sources.
SECRETLINK_TAG=

# ==========================================
# Database Configuration
# ==========================================
# Compte applicatif créé à l'initialisation de la base. Pas `root` : l'image MySQL
# le refuse.
MYSQL_USER=link
MYSQL_PASSWORD=change-me

# ==========================================
# Server Configuration
# ==========================================
NODE_ENV=production

# Origine publique unique de l'application : la SPA à la racine, l'API sous /api.
# C'est la seule URL à déclarer (DNS, reverse proxy, extension, collection Postman),
# et elle sert à construire les liens partageables.
FRONT_BASE_URL=http://localhost

# 1 ferme l'API (503 MAINTENANCE_MODE), sauf GET /health.
MAINTENANCE_MODE=0

# ==========================================
# Security Keys
# ==========================================
# Master encryption key for secrets
MASTER_KEY_V1=your-secret-key-here

# Key version for managing key rotations
KEY_VERSION=1

# Session secret for session management
SESSION_SECRET=your-session-secret-here

# HMAC secret for pseudonymizing IPs / emails in logs (min 32 chars)
IP_HMAC_SECRET=your-ip-hmac-secret-here

# ==========================================
# Reverse proxy / réseau
# ==========================================
# Nombre de proxys de confiance devant l'application, pour la résolution de l'IP
# client (rate limiting et pseudonymisation des logs). Compter les sauts en partant
# du serveur, PAS depuis Internet.
#
# Le nginx du service client, qui proxifie /api, compte comme un saut :
#
#   Topologie                                    Chaîne                                TRUST_PROXY
#   -------------------------------------------- ------------------------------------- -----------
#   Prod (Dokploy)                               CF -> Traefik -> nginx -> serveur      2
#   docker-compose-dev.yml                       navigateur -> nginx -> serveur         1
#   `npm run dev` + `npm start` (proxy Angular)  navigateur -> proxy Angular -> serveur 0
#   Serveur exposé directement, sans proxy       navigateur -> serveur                  0
#
# Trop bas : req.ip s'arrête sur l'edge Cloudflare, CF-Connecting-IP n'est pas promu,
# tous les visiteurs partagent un même compteur de quota et un même hash d'IP.
# Trop haut : n'importe quel client peut forger X-Forwarded-For, contourner les quotas
# et empoisonner les hash d'IP des logs.
#
# À vérifier après tout changement de topologie : relever un `ip_hash` dans les logs et
# le comparer à `.\Get-IpHash.ps1 -Ip <ton IP> -Normalize`.
TRUST_PROXY=2

# Origines CORS autorisées, séparées par des virgules. Vide = valeurs par défaut
# intégrées. FRONT_BASE_URL est toujours autorisée, quelle que soit la valeur.
ALLOWED_ORIGINS=

# IDs des extensions Chrome autorisées à appeler l'API, séparés par des virgules.
# Vide = n'importe quelle origine chrome-extension:// est acceptée.
ALLOWED_EXTENSION_IDS=

# Plages Cloudflare (CIDR séparés par des virgules) autorisées à définir
# CF-Connecting-IP. Vide = plages intégrées à l'application. À renseigner
# uniquement si Cloudflare publie de nouvelles plages avant une mise à jour.
# Un CIDR invalide empêche le démarrage, volontairement.
CLOUDFLARE_IPS=

# ==========================================
# Logging
# ==========================================
LOG_LEVEL=info
